<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="tmp/bootstrap.min.css">
    <script src="tmp/jquery.min.js"></script>
    <script src="tmp/echarts.min.js"></script>
    <style type="text/css">
        body {
            font-family: Arial, sans-serif;
            margin: 10px;
            line-height: 1.4;
            font-size: 12px;
            background-color: #f5f5f5;
        }

        .title {
            width: auto;
            height: 40px;
            text-align: center;
            font: bolder 24px/40px "Arial, sans-serif";
            color: #FFFFFF;
            background-color: #4CAF50;
            border-radius: 4px;
            margin-bottom: 20px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .content-box {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .box1 {
            flex: 2;
        }

        .box2 {
            flex: 5;
        }

        .box3 {
            flex: 3;
        }

        .panel {
            position: relative;
            border: 1px solid #ddd;
            background: #FFFFFF;
            padding: 15px;
            margin-bottom: 12px;
            border-radius: 4px;
            box-shadow: 0 0 5px rgba(0,0,0,0.1);
        }

        .panel h2, .test_info h2 {
            height: 40px;
            line-height: 40px;
            text-align: center;
            color: #333;
            font-size: 16px;
            font-weight: bold;
            margin: 0 0 12px 0;
            background-color: #f5f5f5;
            border-radius: 3px;
        }

        .panel .chart {
            height: 250px;
        }

        .panel .chart2 {
            height: 350px;
        }

        .panel .desc {
            height: auto;
            max-height: 600px;
            overflow-y: auto;
        }

        .panel .desc .info {
            font: normal 14px/25px "Arial, sans-serif";
            color: #333;
            display: flex;
            margin-bottom: 8px;
        }

        .panel .desc .info div {
            padding: 8px;
            border: solid 1px #ddd;
            border-radius: 3px;
            background-color: #f9f9f9;
        }

        .panel .desc .info div span {
            margin-left: 10px;
            color: #666;
        }

        .test_info {
            width: 100%;
            padding: 20px;
            background: #FFFFFF;
            border-radius: 4px;
            box-shadow: 0 0 5px rgba(0,0,0,0.1);
            margin-top: 20px;
        }

        .table {
            border-collapse: collapse;
            width: 100%;
            font-size: 16px;
        }

        .table td, .table th {
            border: 1px solid #ddd !important;
            padding: 8px 6px !important;
            line-height: 1.3;
            text-align: center;
            vertical-align: center;
            font-size: 14px;
            color: #333;
        }

        .table th {
            background-color: #f5f5f5;
            font-weight: bold;
        }

        .btn-primary {
            background-color: #4CAF50;
            border-color: #4CAF50;
            color: white;
            font-size: 12px;
            padding: 4px 8px;
            border-radius: 3px;
        }

        .btn-primary:hover {
            background-color: #45a049;
            border-color: #45a049;
        }

        select {
            border: 1px solid #ddd;
            padding: 4px 8px;
            margin-left: 10px;
            border-radius: 3px;
            background-color: white;
            color: #333;
            font-size: 12px;
        }

        option {
            text-align: center;
            font-size: 12px;
            color: #333;
        }

        .text-success {
            color: #4CAF50 !important;
        }

        .text-warning {
            color: #F44336 !important;
        }

        .text-danger {
            color: #800000 !important;
        }

        .text-info {
            color: #F6C73B !important;
        }

        .chart4 {
            overflow: auto;
            width: 100%;
            height: 150px;
            border: 1px solid #ddd;
            border-radius: 3px;
        }

        .chart4::-webkit-scrollbar {
            width: 8px;
        }

        .chart4::-webkit-scrollbar-thumb {
            border-radius: 4px;
            background: #ccc;
        }

        .chart4::-webkit-scrollbar-track {
            border-radius: 4px;
            background: #f5f5f5;
        }

        a {
            color: #2196F3;
            text-decoration: none;
        }

        a:hover {
            color: #1976D2;
            text-decoration: underline;
        }

        .table_title {
            text-align: center;
            background: #f5f5f5;
            font: bold 14px/30px 'Arial, sans-serif';
            color: #333;
            border-radius: 4px;
            margin-bottom: 10px;
        }

        .test_log {
            background: #f9f9f9;
            width: 100%;
            border-top: none;
            border-bottom: none;
            display: none;
            text-align: left;
        }

        .test_log td {
            text-align: left;
            padding: 10px 20px;
            font-size: 12px;
            color: #333;
            line-height: 1.4;
        }

        pre {
            margin: 0;
            white-space: pre-wrap;
            word-wrap: break-word;
            color: #333;
            line-height: 1.4;
            font-size: 12px;
            background-color: #f5f5f5;
            padding: 10px;
            border-radius: 3px;
        }

        @media (max-width: 768px) {
            .content-box {
                flex-direction: column;
            }
            
            .test_info {
                padding: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="title">
        {{ title }}
    </div>
    
    <div class="content-box">
        <div class="box1">
            <div class="panel">
                <h2>测试结果数量</h2>
                <div class="chart" id="char3"></div>
            </div>
            <div class="panel">
                <h2>测试结果占比</h2>
                <div class="chart" id="char1"></div>
            </div>
        </div>
        
        <div class="box2">
            <div class="panel">
                <h2>测试任务信息</h2>
                <div class="desc">
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">项目名称</button>
                            <span>{{ proj_name }}</span>
                        </div>
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">台架名称</button>
                            <span>{{ tester }}</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">客户端名称</button>
                            <span>{{ client_name }}</span>
                        </div>
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">客户端版本</button>
                            <span>{{ client_version }}</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">触发方式</button>
                            <span>{{ trigger_type }}</span>
                        </div>
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">触发人</button>
                            <span>{{ trigger_user }}</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">开始时间</button>
                            <span>{{ begin_time }}</span>
                        </div>
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">测试用时</button>
                            <span>{{ run_time }}</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">结束时间</button>
                            <span>{{ end_time }}</span>
                        </div>
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">任务编号</button>
                            <span>{{ ptId }}</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">脚本ID</button>
                            <span>{{ scriptId }}</span>
                        </div>
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">脚本版本ID</button>
                            <span>{{ scriptVerId }}</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">用例总数</button>
                            <span>{{ all }}</span>
                        </div>
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">通过率</button>
                            <span>{{ pass_rate }}%</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">脚本名称</button>
                            <span>{{ script_name }}</span>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">升级包文件路径</button>
                            <a href="{{ upgrade_package_path }}">{{ upgrade_package_path }}</a>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">版本信息文件路径</button>
                            <a href="{{ version_info_path }}">{{ version_info_path }}</a>
                        </div>
                    </div>
                    <div class="info">
                        <div style="flex:1">
                            <button type="button" class="btn btn-primary btn-sm">任务详情链接</button>
                            <a href="{{ task_details_url }}">{{ task_details_url }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="box3">
            <div class="panel">
                <h2>历史测试结果</h2>
                <div class="chart4">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">测试时间</th>
                            <th scope="col">用例总数</th>
                            <th scope="col">通过用例数</th>
                            <th scope="col">通过率</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for hos in history[::-1] %}
                        <tr>
                            <th scope="row">{{hos.begin_time}}</th>
                            <td>{{hos.all}}</td>
                            <td>{{hos.success}}</td>
                            <td>{{hos.pass_rate}}%</td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="panel">
                <h2>通过率趋势图</h2>
                <div class="chart2" id="char2"></div>
            </div>
        </div>
    </div>
    
    <div class="test_info">
        <h2>测试用例列表</h2>
        <div class="table_data">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col" style="width: 5%;">序号</th>
                    <th scope="col" style="width: 10%;">用例编号</th>
                    <th scope="col" style="width: 10%;">
                        <span>用例类型</span>
                        <select id="testClass">
                            <option>所有</option>
                            {% for foo in testModules %}
                            <option value="{{foo|replace('\\','')|replace('.','')}}">{{ foo }}</option>
                            {% endfor %}
                        </select>
                    </th>
                    <th scope="col" style="width: 20%;">用例名称</th>
                    <th scope="col" style="width: 25%;">测试结果</th>
                    <th scope="col" style="width: 10%;">测试时间</th>
                    <th scope="col" style="width: 10%;">
                        <span>结果判定</span>
                        <select id="testResult">
                            <option>所有</option>
                            <option class="text-success">通过</option>
                            <option class="text-warning">不通过</option>
                            <option class="text-info">警告</option>
                            <option class="text-danger">错误</option>
                        </select>
                    </th>
                    <th scope="col" style="width: 10%;">详细信息</th>
                </tr>
                </thead>
                <tbody>
                {% for name, foo in cases.items() %}
                <tr class="case_">
                    <td>{{ loop.index }}</td>
                    <td>{{ foo.caseNum }}</td>
                    <td class="{{ foo.testType|replace('\\','')|replace('.','') }}">{{ foo.testType }}</td>
                    <td>{{ foo.testName }}</td>
                    <td>{{ foo.desc }}</td>
                    <td>{{ foo.duration }}</td>
                    {% if foo.outcome == 'passed' %}
                    {% if foo.rerun %}
                    <td style="color: #fa6f6f">通过</td>
                    {% else %}
                    <td class="text-success">通过</td>
                    {% endif %}
                    {% elif foo.outcome == 'failed' %}
                    <td class="text-warning">不通过</td>
                    {% elif foo.outcome == 'error' %}
                    <td class="text-danger">错误</td>
                    {% else %}
                    <td class="text-info">警告</td>
                    {% endif %}
                    <td>
                        <a href="{{foo.url}}">
                            <button type="button" class="btn btn-primary btn-sm">查看详情</button>
                        </a>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

<script type="text/javascript">
    const resulte = {
            "success": '{{passed}}',
            "all": '{{all}}',
            "fail": '{{failed}}',
            "warning": '{{warning}}',
            "error": '{{error}}',
            "runtime": '{{run_time}}',
            "begin_time": '{{start_time}}',
            "pass_rate": '{{pass_rate}}',
        }
    ;
    const history = {{ history}};
    var passRate = [];
    var dTime = [];
    history.forEach(function (item, index, array) {
        passRate.push(item.pass_rate);
        dTime.push(item.begin_time)
    });
    if (passRate.length === 1) {
        passRate.unshift(0);
        dTime.unshift(0)
    }

    function char01() {
        let myChart = echarts.init(document.getElementById('char1'));
        let option = {
            color: ['#28a745', '#ffc107', '#dc3545', '#17a2b8'],
            tooltip: {
                trigger: 'item',
                formatter: '{a} <br/>{b}: {c} ({d}%)',
                backgroundColor: 'rgba(255, 255, 255, 0.9)',
                borderColor: '#ddd',
                textStyle: {
                    color: '#333',
                    fontSize: "13"
                },
            },
            legend: {
                bottom: "0%",
                itemWidth: 10,
                itemHeight: 10,
                data: ['通过', '不通过', '错误', '警告'],
                textStyle: {
                    color: "#333",
                    fontSize: "12"
                },
            },
            series: [
                {
                    name: '测试结果',
                    type: 'pie',
                    radius: ['50%', '70%'],
                    avoidLabelOverlap: false,
                    label: {
                        show: false,
                        position: 'center'
                    },
                    emphasis: {
                        label: {
                            show: true,
                            fontSize: '16',  // 稍微减小字体
                            fontWeight: 'bold',
                            color: '#333',
                        }
                    },
                    labelLine: {
                        show: false
                    },
                    data: [
                        {value: resulte.success, name: '通过'},
                        {value: resulte.fail, name: '不通过'},
                        {value: resulte.error, name: '错误'},
                        {value: resulte.warning, name: '警告'}
                    ]
                }
            ]
        };
        myChart.setOption(option);
    }
                                                             
             

    char01();

    //    大图
    function char02() {

        // 基于准备好的dom，初始化echarts实例
        let myChart = echarts.init(document.getElementById("char2"));
        // 2. 指定配置和数据
        option = {
            tooltip: {
                trigger: 'axis',
                formatter: '{a} <br/>{b}:  ({c}%)',
                backgroundColor: 'rgba(255, 255, 255, 0.9)',
                borderColor: '#ddd',
                textStyle: {
                    color: '#333',
                    fontSize: "13"
                },
            },

            grid: {
                left: "10",
                top: "30",
                right: "10",
                bottom: "0",
                containLabel: true
            },

            xAxis: [{
                type: "category",
                boundaryGap: false,
                show: false,
                axisLabel: {
                    textStyle: {
                        color: "rgba(255,255,255,.6)",
                        fontSize: 12
                    }
                },
                axisLine: {
                    lineStyle: {
                        color: "rgba(255,255,255,.2)"
                    }
                },

                data: dTime
            },
                {
                    axisPointer: {
                        show: false
                    },
                    axisLine: {
                        show: false
                    },
                    position: "bottom",
                    offset: 20
                }
            ],

            yAxis: [{
                type: "value",
                axisTick: {
                    show: false
                },
                axisLine: {
                    lineStyle: {
                        color: "rgba(255,255,255,.1)"
                    }
                },
                axisLabel: {
                    textStyle: {
                        color: "rgba(255,255,255,.6)",
                        fontSize: 12
                    }
                },

                splitLine: {
                    lineStyle: {
                        color: "rgba(255,255,255,.1)"
                    }
                }
            }],
            series: [{
                name: "通过率",
                type: "line",
                smooth: true,
                symbol: "circle",
                symbolSize: 5,
                showSymbol: true,
                lineStyle: {
                    normal: {
                        color: "#0184d5",
                        width: 2
                    }
                },
                areaStyle: {
                    normal: {
                        color: new echarts.graphic.LinearGradient(
                            0,
                            0,
                            0,
                            1,
                            [{
                                offset: 0,
                                color: "rgba(1, 132, 213, 0.4)"
                            },
                                {
                                    offset: 0.8,
                                    color: "rgba(1, 132, 213, 0.1)"
                                }
                            ],
                            false
                        ),
                        shadowColor: "rgba(0, 0, 0, 0.1)"
                    }
                },
                itemStyle: {
                    normal: {
                        color: "#0184d5",
                        borderColor: "rgba(221, 220, 107, .1)",
                        borderWidth: 18
                    }
                },
                data: passRate
            },
            ]
        };
        // 重新把配置好的新数据给实例对象
        myChart.setOption(option);

    }

    char02();

    function char03() {
        let myChart = echarts.init(document.getElementById("char3"));
        var data = [resulte.success, resulte.fail, resulte.error, resulte.warning];
        var titlename = ["通过用例", "不通过用例", "错误用例", "警告用例"];
        var valdata = [resulte.all, resulte.all, resulte.all, resulte.all];
        var myColor = ['#28a745', '#ffc107', '#dc3545', '#17a2b8'];

        option = {
            grid: {
                top: "10%",
                left: "22%",
                bottom: "10%"
            },
            xAxis: {
                show: false
            },
            yAxis: [{
                show: true,
                data: titlename,
                inverse: true,
                axisLine: {
                    show: false
                },
                splitLine: {
                    show: false
                },
                axisTick: {
                    show: false
                },
                axisLabel: {
                    color: "#333",
                    fontSize: 12,   // 明确设置字体大小
                    fontWeight: 'normal'
                }
            }, {
                show: false,
                inverse: true,
                data: valdata,
                axisLabel: {
                    textStyle: {
                        fontSize: 12,
                        color: "#333"
                    }
                },
                axisTick: {
                    show: false
                },
                axisLine: {
                    show: false
                },
            }],
            series: [{
                type: "bar",
                yAxisIndex: 0,
                data: data,
                barCategoryGap: 50,
                barWidth: 18,
                itemStyle: {
                    normal: {
                        barBorderRadius: 20,
                        color: function (params) {
                            var num = myColor.length;
                            return myColor[params.dataIndex % num];
                        }
                    }
                },
                label: {
                    normal: {
                        show: true,
                        position: "right",
                        formatter: "{c}条",
                        color: "#333",
                        fontSize: 12,   // 明确设置字体大小
                        fontWeight: 'bold'
                    }
                }
            }, {
                type: "bar",
                yAxisIndex: 1,
                barCategoryGap: 50,
                data: valdata,
                barWidth: 20,
                itemStyle: {
                    normal: {
                        color: "none",
                        borderColor: "#ddd",  // 改为浅灰色边框
                        borderWidth: 2,
                        barBorderRadius: 15
                    }
                }
            }]
        };

        myChart.setOption(option);
        window.addEventListener("resize", function () {
            myChart.resize();
        });
    }

    char03()

</script>


<script>
    var tbodyTr = $('tbody .case_');
    var testResult = $("#testResult");
    var testClass = $("#testClass");
    <!--    用例执行详细信息显示切换-->
    $(".btn_info").click(function () {
        $(this).parent().parent().next().toggle();

    });
    // 当选择用例类之后触发
    testClass.change(function () {
        $('.test_log').hide();
        var cls = $(this).val();
        var res = testResult.val();
        elementDisplay(cls, res);
        sort()
    });
    testResult.change(function () {
        var res = $(this).val();
        var cls = testClass.val();
        elementDisplay(cls, res);
        sort()
    });

    function elementDisplay(cls, res) {
        // 用例数据的显示
        if (cls === "所有") {
            if (res === "所有") {
                tbodyTr.has('button').show();
            } else if (res === '通过') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.text-success').show()

            } else if (res === '错误') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.text-danger').show()

            } else if (res === '不通过') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.text-warning').show()

            } else if (res === '警告') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.text-info').show()
            }
        } else {
            if (res === "所有") {
                tbodyTr.hide();
                tbodyTr.has('button').has('.' + cls + '').show()
            } else if (res === '通过') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.' + cls + '').has('.text-success').show()
            } else if (res === '错误') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.' + cls + '').has('.text-danger').show()
            } else if (res === '不通过') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.' + cls + '').has('.text-warning').show()
            } else if (res === '警告') {
                tbodyTr.hide();
                tbodyTr.has('button').has('.' + cls + '').has('.text-info').show()
            }
        }
    }

    function sort() {
        //重新排列显示序号
        // 选择所有可以见的tr
        var visibleTr = tbodyTr.filter(":visible");

        visibleTr.each(function (index, element) {
            element.firstElementChild.innerHTML = index + 1;

        })

    }

    $('.nav-tabs li').click(function () {
        $(this).find('a').addClass('active');
        $(this).siblings().find('a').removeClass('active');
        $(this).parent().next().children('.tab-content div').eq($(this).index()).addClass('active show').siblings().removeClass('active show')
    });

</script>


</body>
</html>
